# Copy this file to .env and fill in your own values:
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
# Never commit .env. It holds your API keys and the buyer's private key.

# --- LLM for both agents (Buyer Agent + Warung Agent) ---
# Ollama Cloud key from https://ollama.com (used when set)
OLLAMA_API_KEY=
# Fallback when OLLAMA_API_KEY is empty: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model (default gpt-oss:120b on Ollama)
# LLM_MODEL=gpt-oss:120b

# --- Jev (payment decisions) ---
# OpenCode Zen key from https://opencode.ai (free model jev-1.13-free)
OPENCODE_API_KEY=
# JEV_MODEL=jev-1.13-free
# JEV_BASE_URL=https://opencode.ai/zen

# --- Payment ---
# true  = fake payments, no blockchain (start here)
# false = real x402 payments with test USDC on Base Sepolia
MOCK_PAYMENT=true

# TESTNET ONLY. Never use a wallet that holds real money.
# Buyer: private key (0x + 64 hex characters), from `npm run wallet` or MetaMask
BUYER_PRIVATE_KEY=
# Warung (seller): wallet address only (0x + 40 hex characters)
WARUNG_ADDRESS=
# FACILITATOR_URL=https://x402.org/facilitator

# --- Warung ---
WARUNG_URL=http://localhost:4021
# PORT=4021
# WARUNG_NAME=Warung Bu Sri
# GREEDY_MODE=true   # warung charges double at payment time (scenario 3)
